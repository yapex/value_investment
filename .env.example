# Value Investment Analysis - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# Tushare API Token (Required for A 股 data)
# =============================================================================
# Get your token from: https://tushare.pro/user/token
# Tushare provides A 股 financial data and market data
TUSHARE_TOKEN=your_tushare_token_here

# =============================================================================
# Cache Configuration (Optional)
# =============================================================================
# Directory for caching data (default: ./.cache)
CACHE_DIR=./.cache

# Cache TTL in seconds (default: 86400 = 24 hours)
CACHE_TTL=86400

# =============================================================================
# Default Market (Optional)
# =============================================================================
# Default market for analysis: A (A 股), HK (港股), US (美股)
DEFAULT_MARKET=A

# =============================================================================
# Notes
# =============================================================================
# 1. TUSHARE_TOKEN is required for A 股 data
# 2. HK/US market data uses akshare (no token required)
# 3. HK/US market data uses yfinance (no token required)
# 4. Cache settings are optional, defaults will be used if not specified
